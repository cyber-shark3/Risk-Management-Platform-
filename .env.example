# Copy to .env for local development. Never commit real secrets.
APP_ENV=development
APP_NAME=Risk Management Platform
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=postgresql+psycopg://risk_app:change-me@localhost:5432/risk_platform
SECRET_KEY=replace-with-a-long-random-local-development-secret
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
